<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.craftcore.controller.AuditHistoryController"
      spacing="12" style="-fx-base: #1e293b; -fx-background: #0f172a; -fx-control-inner-background: #0f172a; -fx-accent: #38bdf8; -fx-focus-color: #38bdf8; -fx-background-color: #0f172a;">

    <Label text="Historial de Sanciones (Hibernate) y Auditoría (JDBC)"
           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #f8fafc;"/>

    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS"
             style="-fx-background-color: #0b1120;">
        <Tab text="Historial de Sanciones (ORM)">
            <VBox spacing="10" style="-fx-padding: 10 0 0 0; -fx-background-color: #0b1120;">
                <HBox spacing="8" alignment="CENTER_LEFT"
                      style="-fx-background-color: #111827; -fx-background-radius: 10; -fx-border-color: #1e293b; -fx-border-radius: 10; -fx-padding: 12;">
                    <Label text="Desde:" style="-fx-text-fill: #cbd5e1;"/>
                    <DatePicker fx:id="dpSanctionDesde" prefWidth="135"/>
                    <Label text="Hasta:" style="-fx-text-fill: #cbd5e1;"/>
                    <DatePicker fx:id="dpSanctionHasta" prefWidth="135"/>
                    <Label text="Tipo:" style="-fx-text-fill: #cbd5e1;"/>
                    <ComboBox fx:id="cmbSanctionTipo" prefWidth="120"/>
                    <Button text="Filtrar" onAction="#loadSanctions"
                            style="-fx-background-color: #38bdf8; -fx-text-fill: #082f49; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 6 14; -fx-cursor: hand;"/>
                    <Button text="Limpiar" onAction="#clearSanctionFilters"
                            style="-fx-background-color: #1e293b; -fx-text-fill: #cbd5e1; -fx-background-radius: 8; -fx-padding: 6 12; -fx-cursor: hand;"/>
                </HBox>

                <TableView fx:id="tblSanctions" VBox.vgrow="ALWAYS"
                           style="-fx-background-color: #111827; -fx-control-inner-background: #0f172a; -fx-border-color: #334155;">
                    <columns>
                        <TableColumn fx:id="colSanctionId" text="ID" prefWidth="55"/>
                        <TableColumn fx:id="colSanctionPlayer" text="Jugador" prefWidth="140"/>
                        <TableColumn fx:id="colSanctionTipo" text="Tipo" prefWidth="85"/>
                        <TableColumn fx:id="colSanctionMotivo" text="Motivo" prefWidth="250"/>
                        <TableColumn fx:id="colSanctionEstado" text="Estado" prefWidth="100"/>
                        <TableColumn fx:id="colSanctionAdmin" text="Operador" prefWidth="120"/>
                        <TableColumn fx:id="colSanctionFecha" text="Fecha" prefWidth="160"/>
                    </columns>
                </TableView>

                <HBox spacing="8" alignment="CENTER_RIGHT">
                    <Button text="Revocar Sanción" onAction="#handleRevokeSanction"
                            style="-fx-background-color: #f59e0b; -fx-text-fill: #0f172a; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 7 14; -fx-cursor: hand;"/>
                    <Button text="Eliminar Registro" onAction="#handleDeleteSanction"
                            style="-fx-background-color: #ef4444; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 7 14; -fx-cursor: hand;"/>
                </HBox>
            </VBox>
        </Tab>

        <Tab text="Logs de Auditoría (JDBC)">
            <VBox spacing="10" style="-fx-padding: 10 0 0 0; -fx-background-color: #0b1120;">
                <HBox spacing="8" alignment="CENTER_LEFT"
                      style="-fx-background-color: #111827; -fx-background-radius: 10; -fx-border-color: #1e293b; -fx-border-radius: 10; -fx-padding: 12;">
                    <Label text="Desde:" style="-fx-text-fill: #cbd5e1;"/>
                    <DatePicker fx:id="dpLogDesde" prefWidth="135"/>
                    <Label text="Hasta:" style="-fx-text-fill: #cbd5e1;"/>
                    <DatePicker fx:id="dpLogHasta" prefWidth="135"/>
                    <Label text="Acción:" style="-fx-text-fill: #cbd5e1;"/>
                    <ComboBox fx:id="cmbLogAccion" prefWidth="170"/>
                    <Button text="Consultar JDBC" onAction="#loadAuditLogs"
                            style="-fx-background-color: #38bdf8; -fx-text-fill: #082f49; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 6 14; -fx-cursor: hand;"/>
                    <Button text="Limpiar" onAction="#clearLogFilters"
                            style="-fx-background-color: #1e293b; -fx-text-fill: #cbd5e1; -fx-background-radius: 8; -fx-padding: 6 12; -fx-cursor: hand;"/>
                </HBox>

                <TableView fx:id="tblAuditLogs" VBox.vgrow="ALWAYS"
                           style="-fx-background-color: #111827; -fx-control-inner-background: #0f172a; -fx-border-color: #334155;">
                    <columns>
                        <TableColumn fx:id="colLogId" text="ID" prefWidth="60"/>
                        <TableColumn fx:id="colLogAccion" text="Acción" prefWidth="170"/>
                        <TableColumn fx:id="colLogDetalle" text="Detalle" prefWidth="420"/>
                        <TableColumn fx:id="colLogAdmin" text="Admin" prefWidth="120"/>
                        <TableColumn fx:id="colLogFecha" text="Fecha" prefWidth="160"/>
                    </columns>
                </TableView>

                <HBox spacing="8" alignment="CENTER_RIGHT">
                    <Button text="Agregar Nota Manual" onAction="#handleAddManualLog"
                            style="-fx-background-color: #10b981; -fx-text-fill: #022c22; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 7 14; -fx-cursor: hand;"/>
                    <Button text="Eliminar Log" onAction="#handleDeleteLog"
                            style="-fx-background-color: #ef4444; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 7 14; -fx-cursor: hand;"/>
                </HBox>
            </VBox>
        </Tab>
    </TabPane>

</VBox>
