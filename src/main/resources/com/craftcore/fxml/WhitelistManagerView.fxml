<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.craftcore.controller.WhitelistController"
      spacing="12" style="-fx-base: #1e293b; -fx-background: #0f172a; -fx-control-inner-background: #0f172a; -fx-accent: #38bdf8; -fx-focus-color: #38bdf8; -fx-background-color: #0f172a;">

    <Label text="Gestión de Whitelist y Validación Mojang REST API"
           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #f8fafc;"/>

    <HBox spacing="14" alignment="CENTER_LEFT"
          style="-fx-background-color: #111827; -fx-background-radius: 10; -fx-border-color: #1e293b; -fx-border-radius: 10; -fx-padding: 14;">
        <VBox spacing="10" HBox.hgrow="ALWAYS">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <TextField fx:id="txtUsername" promptText="Nickname oficial de Minecraft (ej: Notch, Jeb_)"
                           HBox.hgrow="ALWAYS" onAction="#handleLookupMojang"
                           style="-fx-background-color: #0f172a; -fx-text-fill: #f8fafc; -fx-prompt-text-fill: #64748b; -fx-border-color: #334155; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 7 12;"/>
                <Button fx:id="btnLookup" text="Consultar Mojang API" onAction="#handleLookupMojang"
                        style="-fx-background-color: #38bdf8; -fx-text-fill: #082f49; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 7 16; -fx-cursor: hand;"/>
            </HBox>
            <HBox spacing="18" alignment="CENTER_LEFT">
                <Label fx:id="lblProfileName" text="Jugador: —" style="-fx-font-weight: bold; -fx-text-fill: #f8fafc;"/>
                <Label fx:id="lblProfileUuid" text="UUID: —" style="-fx-text-fill: #38bdf8;"/>
            </HBox>
            <HBox spacing="10">
                <Button fx:id="btnAddWhitelist" text="Agregar a Whitelist" onAction="#handleAddToWhitelist" disable="true"
                        style="-fx-background-color: #10b981; -fx-text-fill: #022c22; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 7 14; -fx-cursor: hand;"/>
                <Button text="Recargar whitelist.json" onAction="#loadWhitelistTable"
                        style="-fx-background-color: #1e293b; -fx-text-fill: #e2e8f0; -fx-border-color: #475569; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 7 14; -fx-cursor: hand;"/>
            </HBox>
        </VBox>

        <VBox alignment="CENTER" spacing="6" prefWidth="115"
              style="-fx-background-color: #0f172a; -fx-background-radius: 10; -fx-border-color: #334155; -fx-border-radius: 10; -fx-padding: 10;">
            <ImageView fx:id="imgSkin" fitWidth="72" fitHeight="72" preserveRatio="true"/>
            <Label text="Avatar / Skin" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
        </VBox>
    </HBox>

    <TableView fx:id="tblWhitelist" VBox.vgrow="ALWAYS"
               style="-fx-background-color: #111827; -fx-control-inner-background: #0f172a; -fx-border-color: #334155; -fx-border-radius: 8;">
        <columns>
            <TableColumn fx:id="colName" text="Nickname" prefWidth="240"/>
            <TableColumn fx:id="colUuid" text="UUID (whitelist.json)" prefWidth="420"/>
        </columns>
        <placeholder>
            <Label text="No hay jugadores registrados en whitelist.json." style="-fx-text-fill: #94a3b8;"/>
        </placeholder>
    </TableView>

    <HBox spacing="8" alignment="CENTER_RIGHT">
        <Button text="Eliminar seleccionado de Whitelist" onAction="#handleRemoveSelected"
                style="-fx-background-color: #ef4444; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 7 16; -fx-cursor: hand;"/>
    </HBox>

</VBox>
