<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.craftcore.controller.LivePlayersController"
      spacing="12" style="-fx-base: #1e293b; -fx-background: #0f172a; -fx-control-inner-background: #0f172a; -fx-accent: #38bdf8; -fx-focus-color: #38bdf8; -fx-background-color: #0f172a;">

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Moderación en Vivo — Jugadores Conectados"
               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #f8fafc;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblOnlineCount" text="0 jugadores en línea"
               style="-fx-text-fill: #10b981; -fx-font-weight: bold; -fx-background-color: #1e293b; -fx-padding: 4 12; -fx-background-radius: 12;"/>
    </HBox>

    <VBox spacing="10" style="-fx-background-color: #111827; -fx-background-radius: 10; -fx-border-color: #1e293b; -fx-border-radius: 10; -fx-padding: 14;">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Jugador objetivo:" style="-fx-font-weight: bold; -fx-text-fill: #38bdf8;"/>
            <TextField fx:id="txtTargetPlayer" promptText="Seleccioná de la tabla o escribí nickname" prefWidth="240"
                       style="-fx-background-color: #0f172a; -fx-text-fill: #f8fafc; -fx-prompt-text-fill: #64748b; -fx-border-color: #334155; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 6 10;"/>
            <TextField fx:id="txtReason" promptText="Motivo (solo para Kick / Ban / Warn)" HBox.hgrow="ALWAYS"
                       style="-fx-background-color: #0f172a; -fx-text-fill: #f8fafc; -fx-prompt-text-fill: #64748b; -fx-border-color: #334155; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 6 10;"/>
        </HBox>
        <FlowPane hgap="10" vgap="8">
            <MenuButton text="🎮 Modo de Juego"
                        style="-fx-background-color: #1e293b; -fx-border-color: #6366f1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand;">
                <items>
                    <MenuItem text="Supervivencia (Survival)" userData="survival" onAction="#handleQuickGamemode"/>
                    <MenuItem text="Creativo (Creative)" userData="creative" onAction="#handleQuickGamemode"/>
                    <MenuItem text="Aventura (Adventure)" userData="adventure" onAction="#handleQuickGamemode"/>
                    <MenuItem text="Espectador (Spectator)" userData="spectator" onAction="#handleQuickGamemode"/>
                </items>
            </MenuButton>

            <MenuButton text="🛡 Permisos OP"
                        style="-fx-background-color: #1e293b; -fx-border-color: #38bdf8; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand;">
                <items>
                    <MenuItem text="Dar OP (/op)" userData="true" onAction="#handleQuickOperator"/>
                    <MenuItem text="Quitar OP (/deop)" userData="false" onAction="#handleQuickOperator"/>
                </items>
            </MenuButton>

            <Button text="Kick (/kick)" onAction="#handleQuickKick"
                    style="-fx-background-color: #f59e0b; -fx-text-fill: #0f172a; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 6 14; -fx-cursor: hand;"/>
            <Button text="Ban (/ban)" onAction="#handleQuickBan"
                    style="-fx-background-color: #ef4444; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 6 14; -fx-cursor: hand;"/>
            <Button text="Warn (/warn)" onAction="#handleQuickWarn"
                    style="-fx-background-color: #6366f1; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 6 14; -fx-cursor: hand;"/>
        </FlowPane>
    </VBox>

    <TableView fx:id="tblOnlinePlayers" VBox.vgrow="ALWAYS"
               style="-fx-background-color: #111827; -fx-control-inner-background: #0f172a; -fx-border-color: #334155; -fx-border-radius: 8;">
        <columns>
            <TableColumn fx:id="colAvatar" text="Avatar" prefWidth="70"/>
            <TableColumn fx:id="colNickname" text="Jugador" prefWidth="190"/>
            <TableColumn fx:id="colUuid" text="UUID" prefWidth="340"/>
            <TableColumn fx:id="colPing" text="Ping (ms)" prefWidth="100"/>
        </columns>
        <placeholder>
            <Label text="No hay jugadores conectados en este momento. Usá clic derecho sobre un jugador cuando se conecte, o usá la barra superior."
                   style="-fx-text-fill: #94a3b8;"/>
        </placeholder>
    </TableView>

</VBox>
